# Production settings for the EC2 server. On the server, copy this file to backend/.env and fill it in:
#   cp backend/.env.production.example backend/.env
# deploy/setup-ec2.sh reads it. The script sets FRONTEND_DIST_DIR and TRUST_PROXY itself, so leave those out.

# Makes the sign-in cookie Secure (HTTPS only). The setup script refuses to run without it.
NODE_ENV=production

# The site's address: https:// plus the domain you give the setup script.
FRONTEND_URL="https://quiz.yourschool.edu"

# PostgreSQL on this server. The setup script creates this user and database with this password.
# Use a long random password. Letters and digits only keep the URL valid:
#   openssl rand -hex 24
DATABASE_URL="postgresql://quiz:CHANGE_ME@localhost:5432/quiz_platform?schema=public"

# At least 32 characters; 64+ random characters is better:
#   openssl rand -hex 48
JWT_ACCESS_SECRET="CHANGE_ME"

# Encrypts students' passwords so the teacher can export and email them. Exactly 64 hex characters:
#   openssl rand -hex 32
# Keep the same value across deploys, or exported passwords of existing students can't be read.
CREDENTIALS_KEY="CHANGE_ME"

PORT=3000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# Optional, for hosts with no shell (Render): the server creates this teacher account each time it starts, and
# resets its password when TEACHER_PASSWORD changes (change it, then redeploy). Unset TEACHER_EMAIL turns it off.
# TEACHER_EMAIL="teacher@school.edu"
# TEACHER_NAME="Your Name"
# TEACHER_PASSWORD=""
