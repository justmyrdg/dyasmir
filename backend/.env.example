# PostgreSQL connection (local install). With docker-compose Postgres use port 5433.
DATABASE_URL="postgresql://postgres:dyasmir@localhost:5432/quiz_platform?schema=public"

# HTTP
PORT=3000
# Only this origin is allowed by CORS (the Angular app).
FRONTEND_URL="http://localhost:4200"

# JWT secrets - use long random strings in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Login protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# "production" makes the refresh cookie Secure (HTTPS only)
NODE_ENV=development

# Optional: absolute path to the built Angular app (frontend/dist/frontend/browser) to serve it from Express
# FRONTEND_DIST_DIR=
